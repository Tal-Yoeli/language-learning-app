{
  "expo": {
    "name": "Language Learning",
    "slug": "FirstCodexProject",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Language Learning",
      "shortName": "Learn",
      "description": "Local-first language learning with AI flashcards, lessons, and speaking practice.",
      "lang": "en",
      "themeColor": "#1F5E59",
      "backgroundColor": "#F6F5F1",
      "display": "standalone",
      "orientation": "any"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow FirstCodexProject to record your pronunciation practice."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FirstCodexProject to choose text photos for flashcards.",
          "cameraPermission": "Allow FirstCodexProject to take text photos for flashcards.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
