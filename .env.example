# Both values are public by design and are compiled into the app bundle, on
# mobile and on the web. Changing one requires a rebuild, not just a restart.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Never add OPENAI_API_KEY here. It belongs only in Supabase Edge Function
# secrets, where the browser cannot reach it:
#   npx supabase secrets set OPENAI_API_KEY=sk-...
#
# Optional server-side secret, set the same way, restricting which sites may
# call the Edge Functions from a browser:
#   npx supabase secrets set ALLOWED_ORIGINS=https://your-site.example,http://localhost:8081
