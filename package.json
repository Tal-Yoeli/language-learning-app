  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~54.0.36",
    "expo-audio": "~1.1.1",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "^1.24.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "supabase": "^2.104.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan",
    "start:tunnel": "expo start --tunnel",
    "test:learning": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/learning.test.mts tests/engagement.test.mts tests/platform.test.mts tests/responsive.test.mts",
    "typecheck": "tsc --noEmit",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:ios": "expo export -p ios",
    "serve:web": "npx serve dist --single"
  },
  "private": true
